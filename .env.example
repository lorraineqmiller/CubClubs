# --- Database ---------------------------------------------------------------
# Any Postgres connection string. For local development, run
#   npx prisma dev --name cubclubs
# in a second terminal and then `npm run db:url` to fill these in automatically.
# In production this is your hosted Postgres (Neon, Supabase, RDS, …).
DATABASE_URL="postgres://user:password@localhost:5432/cubclubs"
# Only needed for `prisma migrate dev` locally; not used in production.
SHADOW_DATABASE_URL=""

# --- Secrets ----------------------------------------------------------------
# Used to hash client IPs for rate limiting (see lib/ratelimit.ts) — nothing
# identifying is ever stored, just this HMAC. Generate with: openssl rand -hex 32
REVIEW_HMAC_SECRET="change-me-openssl-rand-hex-32"

# Bearer token guarding /admin. Generate with: openssl rand -hex 32
ADMIN_TOKEN="change-me-openssl-rand-hex-32"
